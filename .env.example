# MySQL
DATABASE_URL="mysql://user:password@host:3306/occ"

# Required secrets. Generate independent random values for each deployment.
ENCRYPTION_SECRET="change-me-to-a-long-random-string"
AUTH_USERNAME="admin"
AUTH_PASSWORD="change-me"
AUTH_SECRET="change-me-to-another-long-random-string"

DEFAULT_USD_CNY=7.2

# 自动同步。开关本身在「设置 → 自动同步」里（默认关闭）；
# 设成 false 可以从环境变量层面硬关，即使数据库里开着也不跑。
# AUTO_SYNC_ENABLED=false

# Usage log retention (gzip archives default to ./data/usage-archives)
USAGE_RETENTION_ENABLED=true
USAGE_RAW_RETENTION_DAYS=30
USAGE_DETAIL_RETENTION_DAYS=90
# USAGE_ARCHIVE_DIR=./data/usage-archives
