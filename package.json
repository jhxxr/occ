  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "check:reporting": "node --experimental-strip-types --no-warnings --import ./scripts/alias-hook.mjs scripts/check-reporting.ts",
