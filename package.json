    "lucide-react": "^1.27.0",
    "mysql2": "^3.23.3",
    "next": "16.2.12",
    "node-fetch": "^3.3.2",
    "proxy-agent": "^6.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^5.22.0",
