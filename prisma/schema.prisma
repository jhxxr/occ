// Orbit Control Center — API relay cost & profit schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Upstream API relay provider
/// type: NEWAPI | SUB2API | SUB2_ADMIN | ONEAPI | OTHER
/// SUB2API = 第三方面板（邮箱密码/JWT）
/// SUB2_ADMIN = 自建 Sub2API（管理员 X-API-Key）
model UpstreamProvider {
  id                   String    @id @default(cuid())
  name                 String    @db.VarChar(200)
  baseUrl              String    @db.VarChar(500)
  /// Encrypted credential
  apiKey               String    @default("") @db.VarChar(2000)
  type                 String    @default("NEWAPI") @db.VarChar(20)
  accountEmail         String?   @db.VarChar(200)
  accountPassword      String?   @db.Text
  refreshToken         String?   @db.Text
  tokenExpiresAt       DateTime?
  discountRate         Float     @default(7.2)
  currency             String    @default("USD") @db.VarChar(10)
  alertThreshold       Float     @default(10)
  quotaPerDollar       Float     @default(500000)
  enabled              Boolean   @default(true)
  notes                String?   @db.Text
  lastBalance          Float?
  lastConsumed         Float?
  lastBusinessConsumed Float?
  lastSyncAt           DateTime?
  lastError            String?   @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  snapshots     SnapshotLog[]
  apiKeys       UpstreamApiKey[]
  recharges     UpstreamRechargeLog[]
  adminGroups   SelfHostedGroup[]
  adminAccounts SelfHostedAccount[]
}

/// 第三方 Sub2API 用户侧 API Key（邮箱密码登录那套）
///
/// countAsCost 决定这个 Key 的消耗算不算中转成本。
/// rateMultiplier 只作展示（当前值），不参与任何金额计算 ——
/// 倍率会变且没有生效时间，用它算历史金额会改写历史。
model UpstreamApiKey {
  id              String    @id @default(cuid())
  providerId      String
  remoteKeyId     String    @db.VarChar(100)
  name            String    @default("") @db.VarChar(200)
  keyPreview      String    @default("") @db.VarChar(100)
  groupId         Int?
  groupName       String?   @db.VarChar(200)
  rateMultiplier  Float?
  status          String    @default("active") @db.VarChar(20)
  countAsCost     Boolean   @default(false)
  totalActualCost Float     @default(0)
  todayActualCost Float     @default(0)
  lastSyncAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  provider UpstreamProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, remoteKeyId])
  @@index([providerId, countAsCost])
}

/// 自建 Sub2API 的分组（卖出倍率 + 是否纳入统计）
model SelfHostedGroup {
  id                String   @id @default(cuid())
  providerId        String
  remoteGroupId     Int
  name              String   @db.VarChar(200)
  description       String?  @db.Text
  platform          String   @default("") @db.VarChar(50)
  sellRate          Float    @default(0.4)
  track             Boolean  @default(false)
  status            String   @default("active") @db.VarChar(20)
  lastOfficialCost  Float    @default(0)
  todayOfficialCost Float    @default(0)
  lastRequests      Int      @default(0)
  todayRequests     Int      @default(0)
  lastSyncAt        DateTime?
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  provider UpstreamProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, remoteGroupId])
  @@index([providerId, track])
}

/// 自建 Sub2API 上游账号（反代号），各自设定买号成本
model SelfHostedAccount {
  id                String   @id @default(cuid())
  providerId        String
  remoteAccountId   Int
  name              String   @db.VarChar(200)
  platform          String   @default("") @db.VarChar(50)
  accountType       String   @default("") @db.VarChar(50)
  status            String   @default("active") @db.VarChar(20)
  purchaseCostRmb   Float    @default(0)
  track             Boolean  @default(false)
  groupIds          String   @default("[]") @db.VarChar(2000)
  groupNames        String   @default("") @db.VarChar(2000)
  lastOfficialCost  Float    @default(0)
  todayOfficialCost Float    @default(0)
  lastUsedAt        DateTime?
  extra             String?  @db.Text
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  provider UpstreamProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, remoteAccountId])
  @@index([providerId, track])
}

/// 第三方 Sub2API 用户侧使用明细
model UpstreamUsageLog {
  id              String   @id @default(cuid())
  providerId      String
  remoteId        String   @db.VarChar(100)
  remoteKeyId     String?  @db.VarChar(100)
  keyName         String?  @db.VarChar(200)
  model           String?  @db.VarChar(100)
  groupId         Int?
  groupName       String?  @db.VarChar(200)
  actualCost      Float    @default(0)
  standardCost    Float    @default(0)
  rateMultiplier  Float?
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  cacheReadTokens Int      @default(0)
  totalTokens     Int      @default(0)
  requestType     String?  @db.VarChar(50)
  stream          Boolean  @default(false)
  durationMs      Int?
  requestAt       DateTime
  day             String   @db.VarChar(10)
  raw             String?  @db.LongText
  createdAt       DateTime @default(now())

  @@unique([providerId, remoteId])
  @@index([providerId, requestAt])
  @@index([providerId, remoteKeyId, requestAt])
  @@index([providerId, day])
  @@index([providerId, model])
}

model UpstreamUsageDaily {
  id           String   @id @default(cuid())
  providerId   String
  remoteKeyId  String   @default("") @db.VarChar(100)
  keyName      String   @default("") @db.VarChar(200)
  day          String   @db.VarChar(10)
  requests     Int      @default(0)
  actualCost   Float    @default(0)
  standardCost Float    @default(0)
  totalTokens  Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costRmb      Float    @default(0)
  /// 当天实际采用的购入成本率（¥ / 每 1 面值），写死不随配置改动回溯
  costRateRmb  Float    @default(0)
  /// provider = 建账时的站点折扣率；legacy = 迁移前的历史数据
  costRateSource String @default("provider") @db.VarChar(20)
  countAsCost  Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  @@unique([providerId, remoteKeyId, day])
  @@index([providerId, day])
  @@index([providerId, countAsCost, day])
}

/// 自建 Sub2API 按日×分组 官方用量聚合
///
/// sellRateUsed 与 UpstreamUsageDaily.costRateRmb 同理：当天用的卖出倍率写死，
/// 之后改分组倍率只影响新数据，不回溯改写已出过的报表。
model SelfHostedGroupDaily {
  id              String   @id @default(cuid())
  providerId      String
  remoteGroupId   Int
  groupName       String   @default("") @db.VarChar(200)
  day             String   @db.VarChar(10)
  requests        Int      @default(0)
  officialCost    Float    @default(0)
  actualCost      Float    @default(0)
  totalTokens     Int      @default(0)
  sellRevenueRmb  Float    @default(0)
  /// 该行入账时采用的卖出倍率，写死不随配置改动回溯
  sellRateUsed    Float    @default(0)
  /// group = 建行时的分组倍率；legacy = 迁移前、倍率未知的历史数据
  sellRateSource  String   @default("group") @db.VarChar(20)
  track           Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  @@unique([providerId, remoteGroupId, day])
  @@index([providerId, day])
  @@index([providerId, track, day])
}

model UpstreamRechargeLog {
  id             String   @id @default(cuid())
  providerId     String
  paidRmb        Float    @default(0)
  creditGained   Float    @default(0)
  balanceBefore  Float?
  balanceAfter   Float?
  consumedBefore Float?
  consumedAfter  Float?
  source         String   @default("manual") @db.VarChar(50)
  status         String   @default("confirmed") @db.VarChar(20)
  note           String?  @db.Text
  rechargedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  provider UpstreamProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, rechargedAt])
  @@index([providerId, status])
}

model DownstreamSite {
  id              String    @id @default(cuid())
  name            String    @db.VarChar(200)
  baseUrl         String    @db.VarChar(500)
  adminKey        String    @db.Text
  adminUserId     Int       @default(1)
  quotaPerDollar  Float     @default(500000)
  revenueCurrency String    @default("CNY") @db.VarChar(10)
  excludeUserIds  String    @default("[]") @db.VarChar(2000)
  enabled         Boolean   @default(true)
  notes           String?   @db.Text
  lastConsumed    Float?
  lastRevenue     Float?
  lastSyncAt      DateTime?
  lastError       String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  snapshots DownstreamSnapshot[]
  usageDaily DownstreamUsageDaily[]

  orphanChannels DownstreamOrphanChannel[]
  channelDays DownstreamChannelDay[]
}

/// 下游按日实际消费
///
/// 一行同时存两个口径，别混用：
/// - quota / grossRevenueRmb：**全部账号**的真实消费（含测试号），
///   用来跟上游成本对差值 —— 测试号也烧了上游额度。
/// - revenueRmb：**只算付费账号**，这才是收入。测试号没人付钱，
///   把它算进收入等于虚增利润。
///
/// scope=TOTAL 是全站权威口径（报表求和只认它）；
/// scope=GROUP 仅作分组归因与倍率法对账，避免与 TOTAL 重复相加。
model DownstreamUsageDaily {
  id           String   @id @default(cuid())
  downstreamId String
  day          String   @db.VarChar(10)
  scope        String   @default("TOTAL") @db.VarChar(10)
  groupName    String   @default("") @db.VarChar(200)
  /// 全部账号的原始额度面值（含测试号）
  quota        Float    @default(0)
  /// 被排除账号（测试号）消耗的额度面值
  excludedQuota Float   @default(0)
  /// 付费账号消费折算的人民币 —— 收入口径
  revenueRmb   Float    @default(0)
  /// 全部账号消费折算的人民币 —— 对账口径，不是收入
  grossRevenueRmb Float @default(0)
  /// 折算时采用的额度单位快照
  quotaPerUnit Float    @default(500000)
  requests     Int      @default(0)
  /// 排除口径是否可信：拿不到逐账号数据时为 false，此时 revenue 等于 gross
  excludeResolved Boolean @default(false)
  /// data-export | log-stat
  source       String   @default("log-stat") @db.VarChar(30)
  /// 该日数据是否完整（分页/接口截断时为 false）
  complete     Boolean  @default(true)
  syncedAt     DateTime @default(now())
  updatedAt    DateTime @updatedAt

  downstream DownstreamSite @relation(fields: [downstreamId], references: [id], onDelete: Cascade)

  @@unique([downstreamId, day, scope, groupName])
  @@index([downstreamId, day])
  @@index([day])
}

/// 渠道消费摘要 + 扫描锚点（两级精度）
///
/// 不存日志原文，只存「这段时间每个渠道花了多少」的聚合结果：
/// channels JSON 形如 [{"c":18,"n":"渠道名","q":123.4,"r":56,"m":"模型"}]
///   c=channel id, n=渠道名(空则已删), q=quota 面值, r=请求数, m=模型
///
/// granularity 两档：
/// - DAY  ：day="2026-07-30"，近期精确到天，带渠道名与模型
/// - MONTH：day="2026-07"，老数据压成一个月一行，只留 id/面值/请求数
///          （名字和模型对老数据没用了 —— 成本早填过，渠道也早删了）
///
/// 记录**所有**渠道而不只是已删除的 —— 渠道是后来才被删的，
/// 只缓存当时的死渠道，等它以后被删就再也查不到历史消费了。
///
/// complete=true 即锚点：过去的日志不会再变，下次扫描直接跳过。
/// 「今天」还在累积，永不落锚点。
model DownstreamChannelDay {
  id           String   @id @default(cuid())
  downstreamId String
  /// DAY 时为 YYYY-MM-DD；MONTH 时为 YYYY-MM
  day          String   @db.VarChar(10)
  /// DAY | MONTH
  granularity  String   @default("DAY") @db.VarChar(5)
  /// 该行覆盖多少天（DAY 恒为 1；MONTH 为压缩进来的天数）
  spanDays     Int      @default(1)
  /// 渠道消费摘要 JSON（紧凑键名，见上）
  channels     String   @db.Text
  /// 该段日志条数与总消费面值，用于快速核对
  logCount     Int      @default(0)
  totalQuota   Float    @default(0)
  /// 是否完整扫完；false 时下次会重扫
  complete     Boolean  @default(false)
  scannedAt    DateTime @default(now())

  downstream DownstreamSite @relation(fields: [downstreamId], references: [id], onDelete: Cascade)

  @@unique([downstreamId, day])
  @@index([downstreamId, complete])
  @@index([downstreamId, granularity])
}

/// 旧渠道（已从 NewAPI 删除）的成本补录设置
///
/// 渠道删掉后，日志里 channel id 还在但 join 不到名字，Orbit 也没有对应的上游
/// 成本记录 —— 这部分消费会让毛利虚高。这张表只存**你填的成本口径**，
/// 消费量按周期从 DownstreamChannelDaily 现算，所以换周期不用重扫。
///
/// 成本填法二选一，costMode 决定用哪个：
/// - RATE：按倍率折算 → 该周期 quota ÷ quotaPerUnit × costRate
/// - AMOUNT：填这个渠道的总成本，按周期消费占比分摊
model DownstreamOrphanChannel {
  id           String   @id @default(cuid())
  downstreamId String
  /// NewAPI 日志里的 channel id
  channelId    Int
  /// 日志里残留的渠道名（通常为空，删除后 join 不到）
  channelName  String   @default("") @db.VarChar(200)
  /// 用过的模型（逗号分隔，最多几个，帮你认出这是哪家上游）
  models       String?  @db.VarChar(500)
  /// 全部已扫区间内的累计消费面值（展示用，报表按周期现算）
  quota        Float    @default(0)
  revenueRmb   Float    @default(0)
  quotaPerUnit Float    @default(500000)
  requests     Int      @default(0)
  firstDay     String   @db.VarChar(10)
  lastDay      String   @db.VarChar(10)
  /// RATE | AMOUNT
  costMode     String   @default("RATE") @db.VarChar(10)
  /// 购入成本率（¥ / 每 1 面值），costMode=RATE 时生效
  costRate     Float?
  /// 该渠道的总成本人民币，costMode=AMOUNT 时按周期消费占比分摊
  costAmountRmb Float?
  /// 你是否已确认过这笔成本；未确认时报表会警告成本缺口
  resolved     Boolean  @default(false)
  /// 标记为「无需补录」（例如本来就是自建免费渠道）
  ignored      Boolean  @default(false)
  note         String?  @db.Text
  detectedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  downstream DownstreamSite @relation(fields: [downstreamId], references: [id], onDelete: Cascade)

  @@unique([downstreamId, channelId])
  @@index([downstreamId, resolved])
}

/// 额外成本台账（自建号采购 / 订阅 / 其他固定支出）
///
/// ONE_TIME：整笔计入 startDay 所属的自然周 / 自然月。
/// PERIOD  ：按天直线摊销。账号被风控提前结束时填 actualEndDay，
///           整笔成本改按 startDay → actualEndDay 压缩摊完，历史周月报随之回算。
model OperatingCostEntry {
  id            String   @id @default(cuid())
  name          String   @db.VarChar(200)
  amountRmb     Decimal  @default(0) @db.Decimal(14, 4)
  /// ONE_TIME | PERIOD
  mode          String   @default("ONE_TIME") @db.VarChar(20)
  /// ONE_TIME 记账日；PERIOD 摊销开始日
  startDay      String   @db.VarChar(10)
  /// PERIOD 计划结束日（含）
  plannedEndDay String?  @db.VarChar(10)
  /// PERIOD 实际结束日（含），提前结束后成本压缩到这里
  actualEndDay  String?  @db.VarChar(10)
  /// active | ended | void
  status        String   @default("active") @db.VarChar(20)
  /// self-hosted | relay | other
  category      String   @default("self-hosted") @db.VarChar(30)
  /// 归属上游/自建站点（不做外键，避免删站点连带丢账）
  providerId    String?  @db.VarChar(40)
  /// 归属自建反代账号
  accountId     String?  @db.VarChar(40)
  note          String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([mode, startDay])
  @@index([status])
  @@index([providerId])
  @@index([accountId])
}

model SnapshotLog {
  id            String   @id @default(cuid())
  upstreamId    String
  balance       Float
  consumed      Float    @default(0)
  deltaConsumed Float    @default(0)
  costRmb       Float    @default(0)
  raw           String?  @db.Text
  timestamp     DateTime @default(now())

  upstream UpstreamProvider @relation(fields: [upstreamId], references: [id], onDelete: Cascade)

  @@index([upstreamId, timestamp])
  @@index([timestamp])
}

model DownstreamSnapshot {
  id              String    @id @default(cuid())
  downstreamId    String
  consumed        Float     @default(0)
  revenue         Float     @default(0)
  revenueCurrency String    @default("CNY") @db.VarChar(10)
  periodStart     DateTime?
  periodEnd       DateTime?
  raw             String?   @db.Text
  timestamp       DateTime  @default(now())

  downstream DownstreamSite @relation(fields: [downstreamId], references: [id], onDelete: Cascade)

  @@index([downstreamId, timestamp])
  @@index([timestamp])
}

model AppSetting {
  id    String @id @default(cuid())
  key   String @unique @db.VarChar(100)
  value String @db.Text
}

/// 浏览器扩展注入 JWT 的 token
///
/// token 会以 ?token=… 的形式出现在链接里（方便扩展粘贴），也就会落进
/// 反代访问日志、浏览器历史。所以必须有有效期兜底：泄露的 token 不能永久可用。
/// expiresAt = null 表示永不过期（仅存量老 token，新建一律带期限）。
model ExtensionInjectToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique @db.VarChar(64)
  tokenPrefix String    @db.VarChar(20)
  providerId  String?
  label       String    @default("") @db.VarChar(200)
  enabled     Boolean   @default(true)
  /// 过期时刻；null = 不过期（迁移前建的老 token）
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  useCount    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([providerId])
  @@index([enabled])
}
