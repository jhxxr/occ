// Orbit Control Center — API relay cost & profit schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Upstream API relay provider
/// type: NEWAPI | SUB2API | SUB2_ADMIN | ONEAPI | OTHER
/// SUB2API = 第三方面板（邮箱密码/JWT）
/// SUB2_ADMIN = 自建 Sub2API（管理员 X-API-Key）
model UpstreamProvider {
  id                   String    @id @default(cuid())
  name                 String    @db.VarChar(200)
  baseUrl              String    @db.VarChar(500)
  /// Encrypted credential
  apiKey               String    @default("") @db.VarChar(2000)
  type                 String    @default("NEWAPI") @db.VarChar(20)
  accountEmail         String?   @db.VarChar(200)
  accountPassword      String?   @db.Text
  refreshToken         String?   @db.Text
  tokenExpiresAt       DateTime?
  discountRate         Float     @default(7.2)
  currency             String    @default("USD") @db.VarChar(10)
  alertThreshold       Float     @default(10)
  quotaPerDollar       Float     @default(500000)
  enabled              Boolean   @default(true)
  notes                String?   @db.Text
  lastBalance          Float?
  lastConsumed         Float?
  lastBusinessConsumed Float?
  lastSyncAt           DateTime?
  lastError            String?   @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  snapshots     SnapshotLog[]
  apiKeys       UpstreamApiKey[]
  recharges     UpstreamRechargeLog[]
  adminGroups   SelfHostedGroup[]
  adminAccounts SelfHostedAccount[]
}

/// 第三方 Sub2API 用户侧 API Key（邮箱密码登录那套）
model UpstreamApiKey {
  id              String    @id @default(cuid())
  providerId      String
  remoteKeyId     String    @db.VarChar(100)
  name            String    @default("") @db.VarChar(200)
  keyPreview      String    @default("") @db.VarChar(100)
  groupId         Int?
  groupName       String?   @db.VarChar(200)
  rateMultiplier  Float?
  status          String    @default("active") @db.VarChar(20)
  countAsCost     Boolean   @default(false)
  totalActualCost Float     @default(0)
  todayActualCost Float     @default(0)
  lastSyncAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  provider UpstreamProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, remoteKeyId])
  @@index([providerId, countAsCost])
}

/// 自建 Sub2API 的分组（卖出倍率 + 是否纳入统计）
model SelfHostedGroup {
  id                String   @id @default(cuid())
  providerId        String
  remoteGroupId     Int
  name              String   @db.VarChar(200)
  description       String?  @db.Text
  platform          String   @default("") @db.VarChar(50)
  sellRate          Float    @default(0.4)
  track             Boolean  @default(false)
  status            String   @default("active") @db.VarChar(20)
  lastOfficialCost  Float    @default(0)
  todayOfficialCost Float    @default(0)
  lastRequests      Int      @default(0)
  todayRequests     Int      @default(0)
  lastSyncAt        DateTime?
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  provider UpstreamProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, remoteGroupId])
  @@index([providerId, track])
}

/// 自建 Sub2API 上游账号（反代号），各自设定买号成本
model SelfHostedAccount {
  id                String   @id @default(cuid())
  providerId        String
  remoteAccountId   Int
  name              String   @db.VarChar(200)
  platform          String   @default("") @db.VarChar(50)
  accountType       String   @default("") @db.VarChar(50)
  status            String   @default("active") @db.VarChar(20)
  purchaseCostRmb   Float    @default(0)
  track             Boolean  @default(false)
  groupIds          String   @default("[]") @db.VarChar(2000)
  groupNames        String   @default("") @db.VarChar(2000)
  lastOfficialCost  Float    @default(0)
  todayOfficialCost Float    @default(0)
  lastUsedAt        DateTime?
  extra             String?  @db.Text
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  provider UpstreamProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, remoteAccountId])
  @@index([providerId, track])
}

/// 第三方 Sub2API 用户侧使用明细
model UpstreamUsageLog {
  id              String   @id @default(cuid())
  providerId      String
  remoteId        String   @db.VarChar(100)
  remoteKeyId     String?  @db.VarChar(100)
  keyName         String?  @db.VarChar(200)
  model           String?  @db.VarChar(100)
  groupId         Int?
  groupName       String?  @db.VarChar(200)
  actualCost      Float    @default(0)
  standardCost    Float    @default(0)
  rateMultiplier  Float?
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  cacheReadTokens Int      @default(0)
  totalTokens     Int      @default(0)
  requestType     String?  @db.VarChar(50)
  stream          Boolean  @default(false)
  durationMs      Int?
  requestAt       DateTime
  day             String   @db.VarChar(10)
  raw             String?  @db.LongText
  createdAt       DateTime @default(now())

  @@unique([providerId, remoteId])
  @@index([providerId, requestAt])
  @@index([providerId, remoteKeyId, requestAt])
  @@index([providerId, day])
  @@index([providerId, model])
}

model UpstreamUsageDaily {
  id           String   @id @default(cuid())
  providerId   String
  remoteKeyId  String   @default("") @db.VarChar(100)
  keyName      String   @default("") @db.VarChar(200)
  day          String   @db.VarChar(10)
  requests     Int      @default(0)
  actualCost   Float    @default(0)
  standardCost Float    @default(0)
  totalTokens  Int      @default(0)
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costRmb      Float    @default(0)
  countAsCost  Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  @@unique([providerId, remoteKeyId, day])
  @@index([providerId, day])
  @@index([providerId, countAsCost, day])
}

/// 自建 Sub2API 按日×分组 官方用量聚合
model SelfHostedGroupDaily {
  id              String   @id @default(cuid())
  providerId      String
  remoteGroupId   Int
  groupName       String   @default("") @db.VarChar(200)
  day             String   @db.VarChar(10)
  requests        Int      @default(0)
  officialCost    Float    @default(0)
  actualCost      Float    @default(0)
  totalTokens     Int      @default(0)
  sellRevenueRmb  Float    @default(0)
  track           Boolean  @default(false)
  updatedAt       DateTime @updatedAt

  @@unique([providerId, remoteGroupId, day])
  @@index([providerId, day])
  @@index([providerId, track, day])
}

model UpstreamRechargeLog {
  id             String   @id @default(cuid())
  providerId     String
  paidRmb        Float    @default(0)
  creditGained   Float    @default(0)
  balanceBefore  Float?
  balanceAfter   Float?
  consumedBefore Float?
  consumedAfter  Float?
  source         String   @default("manual") @db.VarChar(50)
  status         String   @default("confirmed") @db.VarChar(20)
  note           String?  @db.Text
  rechargedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  provider UpstreamProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, rechargedAt])
  @@index([providerId, status])
}

model DownstreamSite {
  id              String    @id @default(cuid())
  name            String    @db.VarChar(200)
  baseUrl         String    @db.VarChar(500)
  adminKey        String    @db.Text
  adminUserId     Int       @default(1)
  quotaPerDollar  Float     @default(500000)
  revenueCurrency String    @default("CNY") @db.VarChar(10)
  excludeUserIds  String    @default("[]") @db.VarChar(2000)
  enabled         Boolean   @default(true)
  notes           String?   @db.Text
  lastConsumed    Float?
  lastRevenue     Float?
  lastSyncAt      DateTime?
  lastError       String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  snapshots DownstreamSnapshot[]
}

model SnapshotLog {
  id            String   @id @default(cuid())
  upstreamId    String
  balance       Float
  consumed      Float    @default(0)
  deltaConsumed Float    @default(0)
  costRmb       Float    @default(0)
  raw           String?  @db.Text
  timestamp     DateTime @default(now())

  upstream UpstreamProvider @relation(fields: [upstreamId], references: [id], onDelete: Cascade)

  @@index([upstreamId, timestamp])
  @@index([timestamp])
}

model DownstreamSnapshot {
  id              String    @id @default(cuid())
  downstreamId    String
  consumed        Float     @default(0)
  revenue         Float     @default(0)
  revenueCurrency String    @default("CNY") @db.VarChar(10)
  periodStart     DateTime?
  periodEnd       DateTime?
  raw             String?   @db.Text
  timestamp       DateTime  @default(now())

  downstream DownstreamSite @relation(fields: [downstreamId], references: [id], onDelete: Cascade)

  @@index([downstreamId, timestamp])
  @@index([timestamp])
}

model AppSetting {
  id    String @id @default(cuid())
  key   String @unique @db.VarChar(100)
  value String @db.Text
}

/// 浏览器扩展注入 JWT 的长期 token
model ExtensionInjectToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique @db.VarChar(64)
  tokenPrefix String    @db.VarChar(20)
  providerId  String?
  label       String    @default("") @db.VarChar(200)
  enabled     Boolean   @default(true)
  lastUsedAt  DateTime?
  useCount    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([providerId])
  @@index([enabled])
}
